<div class="layout layout--col layout--stretch-x gap--base relative" data-sw-debug="v2 view={{view}} meters={{ui.meters|map:'key'|join:','}} rain={%if ui.rain%}cal{%else%}dry{%endif%} days={{ui.days|size}}">
{%-if st_on%}{%for sp in (1..2)%}{%if sp == 1%}{%assign sp_c='top--5 right--10'%}{%if view == 4%}{%assign sp_c='top--5 right--10 lg:hidden'%}{%endif%}{%elsif view == 4%}{%assign sp_c='top--5 left--10 hidden lg:block'%}{%else%}{%break%}{%endif%}<span class="absolute {{sp_c}} z--10 label label--small" data-sw-stale>{{ui.stale}}</span>{%endfor%}{%endif%}
{%-if view == 1%}
<div class="hidden lg:block h--[28cqh] lg:portrait:h--[22cqh]"><div class="flex flex--row flex--stretch-y gap--base h--full">
{%-for k in (1..2)%}
{%-if k == 2%}<div class="py--4 shrink-0 4bit:hidden dark:4bit:block{{calm_btw}}" data-sw-between><div class="border--v-60 h--full"></div></div>{%endif%}
{{p_open_g}}<div class="relative h--full w--full">
<div class="absolute inset--0" data-sw-part="{%if k == 1%}baro{%else%}tdial{%endif%}"></div>
<span class="absolute bottom--3 left--4 title title--base lg:portrait:title--small text--bold" data-sw-cap>{%if k == 1%}{{ui.baro.name}}{%else%}{{ui.tdial.name}}{%endif%}</span>
{%-capture dv_row%}

{%-if k == 1%}{%assign arw=ui.baro.arrow%}{%assign arw_i=0%}{%elsif inn%}{%assign arw=inn.arrow%}{%assign arw_i=2%}{%else%}{%assign arw=ui.tdial.arrow%}{%assign arw_i=1%}{%endif%}{%if arw == 'up' or arw == 'down'%}<div class="shrink-0 self--center" data-sw-part="arrow" data-sw-i="{{arw_i}}" data-sw-arrow="{{arw}}"></div>{%endif%}
{%-if k == 1%}<span class="value value--small value--tnums">{{ui.baro.value}}</span><span class="title title--small text--bold">{{ui.baro.unit}}</span>
{%-elsif inn%}<span class="value value--small value--tnums" data-sw-inval>{{inn.temp}}</span><span class="title title--small text--bold">{{ui.tdial.unit}}</span>
{%-else%}<span class="value value--small value--tnums">{{ui.tdial.value}}</span><span class="title title--small text--bold">{{ui.tdial.unit}}</span>{%endif-%}
{%-endcapture%}
<div class="absolute bottom--3 right--4 flex flex--row flex--bottom gap--small" data-sw-cap>{{dv_row}}</div>
{%-if k == 2 and inn%}<div class="absolute top--3 right--4 flex flex--row flex--bottom gap--small text--gray-30 dark:text--gray-30" data-sw-cap data-sw-dialin><div class="shrink-0 self--center h--[3cqh] w--[2cqw]" data-sw-part="loc" data-sw-sq data-sw-i="0" data-sw-loc="out"></div>{%if ui.tdial.arrow == 'up' or ui.tdial.arrow == 'down'%}<div class="shrink-0 self--center text--gray-30 dark:text--gray-30" data-sw-part="arrow" data-sw-i="1" data-sw-arrow="{{ui.tdial.arrow}}"></div>{%endif%}<span class="value value--small value--tnums text--gray-30 dark:text--gray-30">{{ui.tdial.value}}</span><span class="title title--small text--bold text--gray-30 dark:text--gray-30">{{ui.tdial.unit}}</span></div>{%endif%}
</div>{{p_close}}
{%-endfor%}
</div></div>
<div class="hidden lg:block lg:4bit:hidden dark:lg:4bit:block{{calm_btw}} w--full px--4" data-sw-between><div class="border--h-60"></div></div>
{%-endif%}
{%if calm_q%}{%assign mr_m=6%}{%assign mb_m=4%}{%endif%}
{%capture c_meters%}
<div class="flex flex--col gap--small shrink-0 w--[{{30|times:wm|round|at_most:100}}cqw] lg:w--[{{22|times:wm|round|at_most:100}}cqw] lg:portrait:w--full">
<div class="flex flex--row grow{%if view == 2%} lg:portrait:flex--stretch-y{%endif%} gap--small w--full">{%assign any_tw=false%}{%capture c_lab%}{%endcapture%}{%capture c_blk%}{%endcapture%}{%for m in ms%}{%if forloop.index > n_lg%}{%break%}{%endif%}{%assign passes=1%}{%if m.tw or m.key == ph_tw%}{%assign passes=2%}{%assign any_tw=true%}{%endif%}{%capture rc%}{%if view == 1 and m.key == 'baro'%}{%if forloop.index > n_md%} hidden{%else%} flex lg:hidden{%endif%}{%elsif forloop.index > n_md%} hidden lg:flex{%else%} flex{%endif%} flex--row flex--center-y{%endcapture%}{%capture rh%}h--[{{mr_m|times:hm|round|at_most:100}}cqh] lg:h--[{{5|times:hl|round|at_most:100}}cqh]{%if view == 1%} lg:portrait:h--[3cqh]{%endif%}{%endcapture%}{%for pass in (1..passes)%}{%assign h2=''%}{%assign pk='meter'%}{%if pass == 2%}{%assign h2=' data-sw-hum2'%}{%elsif m.tw or m.key == ph_tw%}{%assign pk='meterin'%}{%endif%}{%capture c_lab%}{{c_lab}}<div class="{{rc}} flex--right w--full gap--xsmall {{rh}}"{{h2}}>{%if m.tw or m.key == ph_tw%}<div class="shrink-0" data-sw-part="loc" data-sw-sq data-sw-for="{{m.key}}" data-sw-i="{{2|minus:pass}}" data-sw-loc="{%if pass == 1%}in{%else%}out{%endif%}"></div>{%endif%}<span class="title title--base lg:title--small text--bold" data-sw-mlabel>{{m.label}}</span></div>{%endcapture%}{%capture c_blk%}{{c_blk}}<div class="{{rc}} w--full {{rh}}"{{h2}}><div class="w--full h--[{{mb_m|times:hm|round|at_most:100}}cqh] lg:hidden" data-sw-part="{{pk}}" data-sw-n="5" data-sw-i="{{m.idx}}" data-sw-key="{{m.key}}"></div><div class="hidden lg:block w--full h--[{{4|times:hl|round|at_most:100}}cqh]{%if view == 1%} lg:portrait:h--[3cqh]{%endif%}" data-sw-part="{{pk}}" data-sw-n="10" data-sw-i="{{m.idx}}" data-sw-key="{{m.key}}"></div></div>{%endcapture%}{%endfor%}{%endfor%}{%capture mcol%}flex flex--col flex--between{%endcapture%}
<div class="{{mcol}} shrink-0">{{c_lab}}</div>
<div class="{{mcol}} grow">{{c_blk}}</div>
</div>
</div>{%endcapture%}{%capture c_temp%}
<div class="flex flex--col flex--center gap--medium grow w--min-0">
<div class="flex flex--row flex--center-y flex--center-x w--full gap--medium h--[{{13|times:hm|times:tf|round|at_most:100}}cqh] lg:h--[{{8|times:hl|times:tf|round|at_most:100}}cqh] lg:portrait:h--[{%if view == 2%}9{%else%}5{%endif%}cqh]">{%if ui.icon%}<span class="block shrink-0 h--full aspect--1/1"><img class="image image--adaptive h--full w--full" src="{{ui.icon}}" alt="" data-sw-ink="{{ui.iconInk}}" data-sw-icon></span>{%endif%}
<span class="title {%if view == 2%}title--base lg:title--xlarge{%else%}title--base lg:title--xlarge{%endif%} text--bold w--min-0" data-clamp="2" data-sw-cond>{{ui.cond}}</span>
</div>
<div class="{{rule_w}} h--[{{1|times:hm|round|at_most:100}}cqh]"></div>{%assign th_m=15%}{%assign th_l=13%}{%if inn%}{%assign th_m=22%}{%assign th_l=18%}{%endif%}{%assign tr_cls='flex--row flex--center-y flex--center-x w--full'%}{%assign tg_h='h--full'%}{%if view == 1%}{%assign th_m=22%}{%assign th_l=20%}{%if inn%}{%assign th_m=26%}{%assign th_l=22%}{%endif%}{%endif%}{%assign bw_m=9|times:wm|round%}{%assign bw_l=6|times:wl|round%}{%capture badge_w%}w--[{{bw_m}}cqw] lg:w--[{{bw_l}}cqw]{%if view == 1%} lg:portrait:w--[12cqw]{%endif%}{%endcapture%}{%assign ar_m=0.6%}{%assign ar_l=0.75%}{%if view == 2%}{%assign ar_m=0.3%}{%assign ar_l=0.375%}{%endif%}{%assign dh_m=th_m%}{%assign dh_l=th_l%}{%assign ch_p=7%}{%if inn%}{%assign dh_m=12%}{%assign dh_l=10%}{%assign ch_p=3.5%}{%endif%}{%assign ch_m=dh_m|times:hm|times:tm|times:0.85|round%}{%assign ch_l=dh_l|times:hl|times:tf|times:0.85|round%}{%assign cw_m=ch_m|times:ar_m|times:1.6|round%}{%assign cw_l=ch_l|times:ar_l|times:1.6|round%}{%assign cw_p=ch_p|times:2.1|round%}{%if view == 2%}{%assign cw_p=ch_p|times:1.1|round%}{%endif%}{%capture cbadge%}{%if ui.cue and ui.cue.size > 0%}<div class="shrink-0 h--[{{ch_m}}cqh] lg:h--[{{ch_l}}cqh] lg:portrait:h--[{{ch_p}}cqh] w--[{{cw_m}}cqw] lg:w--[{{cw_l}}cqw] lg:portrait:w--[{{cw_p}}cqw]" data-sw-part="cue" data-sw-cue="{{ui.cue|join:'+'}}"></div>{%endif%}{%endcapture%}
{%if view == 2%}{%assign th_m=th_m|times:1.15%}{%endif%}<div class="flex {{tr_cls}} {{tr_gap|default:'gap--small'}} lg:gap--medium h--[{{th_m|times:hm|times:tm|round|at_most:100}}cqh] lg:h--[{{th_l|times:hl|times:tf|round|at_most:100}}cqh] {%if view == 2%}lg:portrait:h--[17cqh]{%else%}{{tp_h|default:'lg:portrait:h--[8cqh]'}}{%endif%}">{%if inn%}{%assign tw_o='2,1'|split:','%}{%for tw_s in tw_o%}{%assign tw=tw_s|plus:0%}{%if forloop.index == 2%}<div class="border--v-60 h--full"></div>{%endif%}{%if tw == 2%}{%assign tw_dm=13%}{%assign tw_dl=13%}{%if view == 2%}{%assign tw_dm=15%}{%assign tw_dl=11%}{%else%}{%assign tw_dl=12%}{%endif%}{%assign tw_dp=6%}{%else%}{%assign tw_dm=6%}{%assign tw_dl=6%}{%assign tw_dp=3%}{%endif%}
