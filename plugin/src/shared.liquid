<div class="layout">
 <div class="sw-stage w--[100cqw] h--[100cqh]" data-sw-view="{{ view }}"></div>
</div>
{%- assign sw_hide = cf.hide_title_bar | append: '' -%}

{%- unless sw_hide == 'true' or sw_hide == 'yes' or view != 1 %}
<div class="title_bar">
 <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ sw_icon | base64_encode }}" alt="">
 <span class="title">{{ trmnl.plugin_settings.instance_name | default: 'Stereo Weather' }}</span>
