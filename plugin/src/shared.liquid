{% template main %}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- capture sw_icon -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="2" y="13" width="4" height="9" fill="#000"/><rect x="2" y="9" width="4" height="2" fill="#000"/><rect x="8" y="6" width="4" height="16" fill="#000"/><rect x="8" y="2" width="4" height="2" fill="#000"/><rect x="14" y="10" width="4" height="12" fill="#000"/><rect x="14" y="6" width="4" height="2" fill="#000"/><rect x="20" y="16" width="2" height="6" fill="#000"/></svg>{%- endcapture -%}
{%- if ui == nil or ui.ok != true -%}
<div class="layout layout--col layout--center" data-sw-error="{{ model.reason | default: 'NO SIGNAL' | escape }}">
 <span class="title title--xlarge">{{ i18n.ours.no_signal | default: 'NO SIGNAL' }}</span>
 <span class="description">{{ model.reason | escape }}</span>
</div>
{%- elsif view == 1 -%}
<div class="layout layout--col layout--stretch-x gap--small" data-sw-debug="v2 full meters={{ ui.meters | map: 'key' | join: ',' }} rain={% if ui.rain %}cal{% else %}dry{% endif %} days={{ ui.days | size }}">
 {%- comment -%} 1. dials (placeholder faces for step 1) {%- endcomment -%}
 <div class="grid grid--cols-2 gap--small h--[27cqh]">
  <div class="outline flex flex--col p--2 h--full">
   <div class="grow w--full">{{ ui.baro.svg }}</div>
   <div class="flex flex--row flex--between flex--bottom w--full">
    <span class="value value--large value--tnums">{{ ui.baro.value }} <span class="label">hPa</span></span>
    <span class="title">{{ ui.baro.name }}</span>
   </div>
  </div>
  <div class="outline flex flex--col p--2 h--full">
   <div class="grow w--full">{{ ui.tdial.svg }}</div>
   <div class="flex flex--row flex--between flex--bottom w--full">
    <span class="value value--large">{{ ui.tdial.unit }}</span>
    <span class="title">{{ ui.tdial.name }}</span>
   </div>
  </div>
 </div>
 {%- comment -%} 2. console: meters, temperature, rain {%- endcomment -%}
 <div class="outline flex flex--row flex--stretch-y gap--large p--4 h--[37cqh]">
  <div class="flex flex--col gap--xsmall w--[34cqw]">
   <div class="flex flex--row gap--small h--[4cqh]">
    {%- for f in ui.flags %}<span class="label label--inverted">{{ f }}</span>{% endfor -%}
   </div>
   <div class="flex flex--col flex--between grow">
   {%- for m in ui.meters %}
    <div class="flex flex--row flex--center-y gap--small h--[5cqh]">
     <span class="label text--right w--[10cqw]">{{ m.label }}</span>
     <div class="grow h--full">{{ m.svg }}</div>
    </div>
   {%- endfor %}
   </div>
  </div>
  <div class="flex flex--col flex--center gap--medium grow">
   <div class="flex flex--row flex--center-y gap--medium h--[9cqh]">
    {%- if ui.icon %}<img class="image image--adaptive h--full" src="{{ ui.icon }}" alt="">{% endif %}
    <span class="title title--large" data-clamp="1">{{ ui.cond }}</span>
   </div>
   <div class="flex flex--row flex--center-y gap--small h--[13cqh]">
    <div class="h--[10cqh]">{{ ui.thermo }}</div>
    <div class="h--full">{{ ui.temp }}</div>
    <span class="value value--small flex--top">{{ ui.unit }}</span>
    {%- if ui.feels %}
    <div class="h--[8cqh] flex flex--row gap--xsmall">{{ ui.person }}<div class="h--[6cqh]">{{ ui.feels }}</div></div>
    {%- endif %}
   </div>
  </div>
  <div class="flex flex--col flex--center gap--small w--[24cqw]">
   {%- if ui.rain %}
   <img class="image image--adaptive h--[12cqh]" src="{{ ui.rain.icon }}" alt="">
   <div class="w--full h--[12cqh] label">{{ ui.rain.cal }}</div>
   {%- else %}
   <img class="image image--adaptive h--[10cqh]" src="{{ ui.dry.moon }}" alt="">
   <div class="flex flex--row flex--center-y gap--small"><img class="image image--adaptive h--[5cqh]" src="{{ ui.dry.riseIcon }}" alt=""><span class="value value--small value--tnums">{{ ui.dry.rise }}</span></div>
   <div class="flex flex--row flex--center-y gap--small"><img class="image image--adaptive h--[5cqh]" src="{{ ui.dry.setIcon }}" alt=""><span class="value value--small value--tnums">{{ ui.dry.set }}</span></div>
   {%- endif %}
  </div>
 </div>
 {%- comment -%} 3. days strip on one shared scale {%- endcomment -%}
 <div class="outline flex flex--col flex--between grow p--4">
  <div class="grid grid--cols-12 gap--small h--[5cqh]">
   <div class="col--span-2"></div>
   <div class="col--span-1 h--[3cqh]">{{ ui.lo }}</div>
   <div class="col--span-1 h--[3cqh]">{{ ui.hi }}</div>
   <div class="col--span-8 h--full value value--xsmall">{{ ui.scale }}</div>
  </div>
  {%- for d in ui.days %}
  <div class="grid grid--cols-12 gap--small h--[5cqh]">
   <span class="col--span-1 title">{{ d.name }}</span>
   <div class="col--span-1 h--full">{% if d.icon %}<img class="image image--adaptive h--full" src="{{ d.icon }}" alt="">{% endif %}</div>
   <span class="col--span-1 value value--small value--tnums text--right">{{ d.lo }}</span>
   <span class="col--span-1 value value--small value--tnums text--right">{{ d.hi }}</span>
   <div class="col--span-8 h--full">{{ d.blocks }}</div>
  </div>
  {%- endfor %}
 </div>
</div>
{%- else -%}
<div class="layout layout--col layout--center gap--small" data-sw-debug="v2 placeholder view={{ view }}">
 <div class="flex flex--row flex--center-y gap--small h--[30cqh]">
  {%- if ui.icon %}<img class="image image--adaptive h--full" src="{{ ui.icon }}" alt="">{% endif %}
  <div class="h--full">{{ ui.temp }}</div>
 </div>
 <span class="title">{{ ui.cond }}</span>
</div>
{%- endif -%}
{%- assign sw_hide = cf.hide_title_bar | append: '' -%}
{%- unless sw_hide == 'true' or sw_hide == 'yes' or view != 1 %}
<div class="title_bar">
 <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ sw_icon | base64_encode }}" alt="">
 <span class="title">{{ trmnl.plugin_settings.instance_name | default: 'Radio Weather' }}</span>
 {%- if clock != blank %}<span class="instance">Open-Meteo · {{ clock }}</span>{% endif %}
</div>
{%- endunless %}
{% endtemplate %}
