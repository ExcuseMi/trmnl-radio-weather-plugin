   <div class="absolute bottom--3 right--4 flex flex--row flex--bottom gap--small" data-sw-cap>{{ dv_row }}</div>
   {%- if k == 2 and ui.inn %}<div class="absolute top--3 right--4 flex flex--row flex--bottom gap--small text--gray-50 dark:text--gray-45" data-sw-cap data-sw-dialin>{% comment %} owner 2026-11-13 {% endcomment %}<div class="shrink-0 self--center h--[3cqh] w--[2cqw]" data-sw-part="loc" data-sw-sq data-sw-i="1" data-sw-loc="in"></div><div class="shrink-0 self--center text--gray-50 dark:text--gray-45" data-sw-part="arrow" data-sw-i="2"{% if ui.inn.arrow %} data-sw-arrow="{{ ui.inn.arrow }}"{% endif %}></div><span class="value value--small value--tnums text--gray-50 dark:text--gray-45">{{ ui.inn.temp }}</span><span class="title title--small text--bold text--gray-50 dark:text--gray-45">{{ ui.tdial.unit }}</span></div>{% endif %}
