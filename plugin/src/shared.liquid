{% template main %}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- capture sw_icon -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="2" y="13" width="4" height="9" fill="#000"/><rect x="2" y="9" width="4" height="2" fill="#000"/><rect x="8" y="6" width="4" height="16" fill="#000"/><rect x="8" y="2" width="4" height="2" fill="#000"/><rect x="14" y="10" width="4" height="12" fill="#000"/><rect x="14" y="6" width="4" height="2" fill="#000"/><rect x="20" y="16" width="2" height="6" fill="#000"/></svg>{%- endcapture -%}
{%- comment -%} Receiver panel: shadow (light, 2-bit and up), heavy dark frame, thin inner line. {%- endcomment -%}
{%- capture p_open -%}<div class="relative h--full w--full"><div class="absolute top--1.5 left--1.5 w--full h--full rounded--large bg--gray-55 dark:hidden 1bit:hidden"></div><div class="relative z--1 h--full w--full rounded--large bg--black p--1 lg:p--2"><div class="h--full w--full rounded bg--white p--1">{%- endcapture -%}
{%- capture p_close -%}</div></div></div>{%- endcapture -%}
{%- if ui == nil or ui.ok != true -%}
<div class="layout layout--col layout--center" data-sw-error="{{ model.reason | default: 'NO SIGNAL' | escape }}">
 <span class="title title--xlarge">{{ i18n.ours.no_signal | default: 'NO SIGNAL' }}</span>
 <span class="description">{{ model.reason | escape }}</span>
</div>
{%- elsif view >= 1 and view <= 4 -%}
{%- comment -%} One console and one days strip for every view; per view: what shows, stacked or side by side, and a size factor for the cqh/cqw values (1 = the full view the values were tuned for). {%- endcomment -%}
{%- assign stk = false %}{% assign hm = 1 %}{% assign hl = 1 %}{% assign wm = 1 %}{% assign wl = 1 %}{% assign n_md = 9 %}{% assign n_lg = 9 %}{% assign nd_md = 4 %}{% assign nd_lg = 5 %}{% assign hide_today_lg = false %}{% assign num_cls = '' %}{% assign bar_cls = 'col--span-8' %}{% assign name_cls = 'col--span-1' %}{% assign pad_cls = 'col--span-2' %}{% assign rgw_l = 18 %}
{%- if view == 1 %}{% assign hide_today_lg = true %}{% assign num_cls = ' lg:portrait:hidden' %}{% assign bar_cls = 'col--span-8 lg:portrait:col--span-10' %}{% assign row_p = ' lg:portrait:h--[6cqh]' %}{% assign last_p = ' lg:portrait:hidden' %}{% assign con_h = 'h--[55cqh] lg:h--[33cqh]' %}{% assign days_h = 'h--[38cqh] lg:h--[31cqh]' %}
{%- elsif view == 2 %}{% assign hm = 1.7 %}{% assign hl = 2.2 %}{% assign rgw_l = 15 %}{% assign mh_l = 1.5 %}{% assign con_h = 'h--full' %}
{%- elsif view == 3 %}{% assign stk = true %}{% assign wm = 2 %}{% assign wl = 2 %}{% assign n_md = 2 %}{% assign n_lg = 5 %}{% assign name_cls = 'col--span-2 lg:col--span-1' %}{% assign pad_cls = 'col--span-3 lg:col--span-2' %}{% assign nd_lg = 6 %}{% assign num_cls = ' hidden lg:flex' %}{% assign bar_cls = 'col--span-9 lg:col--span-8' %}{% assign con_h = 'h--[52cqh] lg:h--[54cqh]' %}{% assign days_h = 'h--[46cqh] lg:h--[44cqh]' %}
{%- else %}{% assign stk = true %}{% assign wm = 2 %}{% assign wl = 2 %}{% assign hm = 1.6 %}{% assign hl = 1.7 %}{% assign n_md = 1 %}{% assign n_lg = 3 %}{% assign con_h = 'h--full' %}{% endif %}
{%- if mh_l == nil %}{% assign mh_l = hl %}{% endif %}
{%- comment -%} Right column: rain unit and sun unit side by side on lg; stacked views keep the icon above the grid and the moon beside the sun times. {%- endcomment -%}
{%- assign q1 = 5 | times: wm | round %}{% assign q2 = 23 | times: wm | round %}{% assign q3 = 26 | times: wl | round %}{% assign q4 = 30 | times: wm | round | at_most: 100 %}{% assign ru_cls = 'flex--col lg:flex--row lg:portrait:flex--col' %}{% assign ri_md = 'w--[' | append: q1 | append: 'cqw] lg:hidden lg:portrait:block lg:portrait:w--[4cqw]' %}{% assign ri_lg = 'hidden lg:block lg:portrait:hidden' %}{% assign su_cls = 'flex--col lg:flex--row lg:portrait:flex--col' %}{% assign rg_p = ' lg:portrait:w--full' %}{% assign rc_w = 'w--[' | append: q2 | append: 'cqw] lg:w--[' | append: q3 | append: 'cqw] lg:portrait:gap--xsmall' %}{% assign rule_w = 'w--[' | append: q4 | append: 'cqw]' %}
{%- if stk %}{% assign ri_md = 'w--[8cqw] lg:hidden' %}{% assign rgw_l = 12 %}{% assign rg_p = '' %}{% assign su_cls = 'flex--row' %}{% assign rc_w = 'w--[40cqw] lg:w--[38cqw] shrink-0' %}{% assign rule_w = 'w--full' %}{% assign tf = 0.7 %}{% assign mh_l = 0.45 %}{% if ui.rain %}{% assign su_cls = 'hidden lg:flex flex--row' %}{% assign sep_cls = ' hidden lg:block' %}{% endif %}{% endif %}
{%- if tf == nil %}{% assign tf = 1 %}{% endif %}
{%- if stk %}{% assign ms = ui.meters | sort: 'rank' %}{% else %}{% assign ms = ui.meters %}{% endif %}
<div class="layout layout--col layout--stretch-x gap--medium" data-sw-debug="v2 view={{ view }} meters={{ ui.meters | map: 'key' | join: ',' }} rain={% if ui.rain %}cal{% else %}dry{% endif %} days={{ ui.days | size }}">
{%- if view == 1 %}
 <div class="hidden lg:block h--[30cqh]"><div class="grid grid--cols-2 gap--medium h--full">
  {%- for k in (1..2) %}
  {{ p_open }}<div class="relative h--full w--full rounded--small outline">
   <div class="absolute inset--0" data-sw-part="{% if k == 1 %}baro{% else %}tdial{% endif %}"></div>
   <span class="absolute top--3 {% if k == 1 %}left--3{% else %}right--3{% endif %} label label--inverted text--bold">{% if k == 1 %}L{% else %}R{% endif %}</span>
   <div class="absolute bottom--3 left--4 flex flex--row flex--bottom gap--small">
    {%- if k == 1 %}<span class="value value--small value--tnums">{{ ui.baro.value }}</span><span class="title title--small text--bold">{{ ui.baro.unit }}</span>
    {%- else %}<span class="value value--small">{{ ui.tdial.unit }}</span>{% endif -%}
   </div>
   <span class="absolute bottom--4 right--5 title title--base text--bold">{% if k == 1 %}{{ ui.baro.name }}{% else %}{{ ui.tdial.name }}{% endif %}</span>
  </div>{{ p_close }}
  {%- endfor %}
 </div></div>
{%- endif %}
{%- capture c_meters %}
  <div class="flex flex--col gap--small {% if stk %}w--full{% else %}w--[{{ 35 | times: wm | round | at_most: 100 }}cqw]{% endif %}">
   <div class="flex flex--row flex--left gap--small h--[{{ 6 | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ 4 | times: hl | round | at_most: 100 }}cqh] w--full">
    {%- for f in ui.flags %}<span class="label label--inverted label--large text--bold">{{ f }}</span>{% endfor -%}
   </div>
   <div class="flex flex--col {% if stk %}gap--small{% else %}flex--between grow{% endif %} w--full">
   {%- for m in ms %}{% if forloop.index > n_lg %}{% break %}{% endif %}
    <div class="w--full{% if forloop.index > n_md %} hidden lg:block{% endif %}">
    <div class="flex flex--row flex--center-y gap--small h--[{{ 9 | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ 5 | times: hl | round | at_most: 100 }}cqh]">
     <div class="w--[{{ 13 | times: wm | round | at_most: 100 }}cqw] lg:w--[{{ 11 | times: wl | round | at_most: 100 }}cqw] text--right"><span class="title title--base lg:title--small text--bold">{{ m.label }}</span></div>
     <div class="w--[{{ 18 | times: wm | round | at_most: 100 }}cqw] h--[{{ 7 | times: hm | round | at_most: 100 }}cqh] lg:hidden" data-sw-part="meter" data-sw-n="5" data-sw-i="{{ m.idx }}"></div>
     <div class="hidden lg:block w--[{{ 22 | times: wl | round | at_most: 100 }}cqw] h--[{{ 4 | times: hl | round | at_most: 100 }}cqh]" data-sw-part="meter" data-sw-n="10" data-sw-i="{{ m.idx }}"></div>
    </div></div>
   {%- endfor %}
   </div>
  </div>
{%- endcapture %}
{%- capture c_temp %}
  <div class="flex flex--col flex--center gap--medium grow">
   <div class="flex flex--row flex--center-y gap--medium h--[{{ 13 | times: hm | times: tf | round | at_most: 100 }}cqh] lg:h--[{{ 8 | times: hl | times: tf | round | at_most: 100 }}cqh] lg:portrait:h--[5cqh]">
    {%- if ui.icon %}<img class="image image--adaptive h--full" src="{{ ui.icon }}" alt="">{% endif %}
    <span class="title title--base text--bold" data-clamp="2">{{ ui.cond }}</span>
   </div>
   <div class="{{ rule_w }} h--[{{ 1 | times: hm | round | at_most: 100 }}cqh]" data-sw-part="rule"></div>
   <div class="flex flex--row flex--center-y gap--small lg:gap--medium h--[{{ 15 | times: hm | times: tf | round | at_most: 100 }}cqh] lg:h--[{{ 13 | times: hl | times: tf | round | at_most: 100 }}cqh] lg:portrait:h--[8cqh]">
    <div class="flex flex--row flex--top gap--xsmall h--full"><div class="h--full" data-sw-part="temp"></div><span class="value value--small" data-sw-unit>{{ ui.unit }}</span></div>
    {%- if ui.feels %}
    <div data-sw-div class="border--v-60 h--[{{ 12 | times: hm | times: tf | round | at_most: 100 }}cqh] lg:h--[{{ 9 | times: hl | times: tf | round | at_most: 100 }}cqh] lg:portrait:h--[6cqh]"></div>
    <div class="h--[{{ 10 | times: hm | times: tf | round | at_most: 100 }}cqh] lg:h--[{{ 8 | times: hl | times: tf | round | at_most: 100 }}cqh] lg:portrait:h--[5cqh]" data-sw-part="person"></div>
    <div class="h--[{{ 9 | times: hm | times: tf | round | at_most: 100 }}cqh] lg:h--[{{ 7 | times: hl | times: tf | round | at_most: 100 }}cqh] lg:portrait:h--[4cqh]" data-sw-part="feels"></div>
    {%- endif %}
   </div>
  </div>
{%- endcapture %}
{%- capture c_right %}
  <div class="flex flex--col flex--center gap--xsmall lg:gap--small {{ rc_w }}">
   {%- if ui.rain %}
   <div class="flex {{ ru_cls }} flex--center gap--xsmall lg:gap--small w--full shrink-0" data-sw-unit="rain">
    <img class="image image--adaptive {{ ri_md }}" src="{{ ui.rain.icon }}" alt="">
    <img class="image image--adaptive {{ ri_lg }} h--[{{ 8 | times: hl | round | at_most: 100 }}cqh] shrink-0" src="{{ ui.rain.icon }}" alt="">
    <div class="w--full lg:w--[{{ rgw_l | times: wl | round | at_most: 100 }}cqw]{{ rg_p }} lg:portrait:h--[6cqh] h--[{{ 12 | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ 8 | times: hl | round | at_most: 100 }}cqh] shrink-0" data-sw-part="rain"></div>
   </div>
   <div class="w--full h--[{{ 1 | times: hm | round | at_most: 100 }}cqh] shrink-0{{ sep_cls }}" data-sw-part="rule" data-sw-sep="rain-sun"></div>
   {%- endif %}
   {%- if ui.rain %}{% assign si_m = 6 %}{% assign si_l = 5 %}{% else %}{% assign si_m = 8 %}{% assign si_l = 8 %}{% endif %}
   <div class="flex {{ su_cls }} flex--center gap--xsmall lg:gap--medium shrink-0" data-sw-unit="sun">
    <div class="h--[{% if ui.rain %}{{ 5 | times: hm | round | at_most: 100 }}{% else %}{{ 11 | times: hm | round | at_most: 100 }}{% endif %}cqh] lg:hidden" data-sw-part="moon"></div>
    <div class="hidden lg:block h--[{% if ui.rain %}{{ 11 | times: mh_l | round | at_most: 100 }}{% else %}{{ 13 | times: mh_l | round | at_most: 100 }}{% endif %}cqh] lg:portrait:h--[4cqh]" data-sw-part="moon"></div>
    <div class="flex flex--col{% if ui.rain %}{% else %} gap--small{% endif %}">
     <div class="flex flex--row flex--center-y gap--small"><img class="image image--adaptive h--[{{ si_m | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ si_l | times: hl | round | at_most: 100 }}cqh] lg:portrait:h--[4cqh]" src="{{ ui.sun.riseIcon }}" alt=""><span class="title title--base{% unless ui.rain or stk %} lg:title--large{% endunless %} text--bold">{{ ui.sun.rise }}</span></div>
     <div class="flex flex--row flex--center-y gap--small"><img class="image image--adaptive h--[{{ si_m | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ si_l | times: hl | round | at_most: 100 }}cqh] lg:portrait:h--[4cqh]" src="{{ ui.sun.setIcon }}" alt=""><span class="title title--base{% unless ui.rain or stk %} lg:title--large{% endunless %} text--bold">{{ ui.sun.set }}</span></div>
    </div>
   </div>
  </div>
{%- endcapture %}
 <div class="{{ con_h }}">{{ p_open }}<div class="flex {% if stk %}flex--col flex--center gap--small{% else %}flex--row flex--stretch-y gap--medium lg:gap--large{% endif %} p--2 lg:p--4 h--full rounded--small outline">
{%- if stk %}
  <div class="flex flex--row flex--stretch-y gap--medium w--full">
{{ c_temp }}
  <div class="border--v-60"></div>
{{ c_right }}
  </div>
  <div class="w--full border--h-60"></div>
{{ c_meters }}
{%- else %}
{{ c_meters }}
  <div class="border--v-60"></div>
{{ c_temp }}
  <div class="border--v-60"></div>
{{ c_right }}
{%- endif %}
 </div>{{ p_close }}</div>
{%- if days_h %}
 <div class="{{ days_h }}">{{ p_open }}<div class="flex flex--col flex--center h--full p--2 lg:p--4 rounded--small outline">
  <div class="grid grid--cols-12 gap--small h--[{{ 6 | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ 4 | times: hl | round | at_most: 100 }}cqh]">
   <div class="{{ pad_cls }}"></div>
   <div class="col--span-1 flex flex--center h--full{{ num_cls }}"><div class="h--[{{ 4 | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ 3 | times: hl | round | at_most: 100 }}cqh] w--[{{ 2 | times: wm | round | at_most: 100 }}cqw]" data-sw-part="tri" data-sw-i="0"></div></div>
   <div class="col--span-1 flex flex--center h--full{{ num_cls }}"><div class="h--[{{ 4 | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ 3 | times: hl | round | at_most: 100 }}cqh] w--[{{ 2 | times: wm | round | at_most: 100 }}cqw]" data-sw-part="tri" data-sw-i="1"></div></div>
   <div class="{{ bar_cls }} h--full" data-sw-part="scale"></div>
  </div>
  {%- assign t0 = ui.days.first.today %}{% assign nd_last = nd_lg | minus: 1 %}
  {%- for d in ui.days %}
  {%- assign i = forloop.index0 %}{% assign on_md = false %}{% assign on_lg = false %}
  {%- if i < nd_md %}{% assign on_md = true %}{% endif %}
  {%- assign j = i %}{% if t0 and hide_today_lg %}{% assign j = i | minus: 1 %}{% endif %}
  {%- if j >= 0 and j < nd_lg %}{% assign on_lg = true %}{% endif %}
  {%- if on_md or on_lg %}
  <div class="w--full{% if on_md and on_lg %}{% elsif on_md %} lg:hidden{% else %} hidden lg:block{% endif %}{% if j == nd_last %}{{ last_p }}{% endif %}" data-sw-row="day">
  <div class="grid grid--cols-12 gap--small h--[{{ 6 | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ 4 | times: hl | round | at_most: 100 }}cqh]{{ row_p }}">
   <div class="{{ name_cls }} flex flex--center-y"><div class="flex flex--col gap--xsmall"><span class="title title--base text--bold">{{ d.name }}</span>{%- if d.today %}<div class="w--full border--h-black lg:hidden" data-sw-today></div>{% endif %}</div></div>
   <div class="col--span-1 flex flex--center">{% if d.icon %}<img class="image image--adaptive h--[{{ 6 | times: hm | round | at_most: 100 }}cqh] lg:h--[{{ 5 | times: hl | round | at_most: 100 }}cqh]" src="{{ d.icon }}" alt="">{% endif %}</div>
   <div class="col--span-1 flex flex--center{{ num_cls }}"><span class="title title--base text--bold">{{ d.lo }}</span></div>
   <div class="col--span-1 flex flex--center{{ num_cls }}"><span class="title title--base text--bold">{{ d.hi }}</span></div>
   <div class="{{ bar_cls }} h--full" data-sw-part="day" data-sw-i="{{ forloop.index0 }}"></div>
  </div></div>
  {%- endif %}
  {%- endfor %}
 </div>{{ p_close }}</div>
{%- endif %}
</div>
{%- endif -%}
{%- assign sw_hide = cf.hide_title_bar | append: '' -%}
{%- unless sw_hide == 'true' or sw_hide == 'yes' or view != 1 %}
<div class="title_bar">
 <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ sw_icon | base64_encode }}" alt="">
 <span class="title">{{ trmnl.plugin_settings.instance_name | default: 'Radio Weather' }}</span>
 {%- if clock != blank %}<span class="instance">Open-Meteo · {{ clock }}</span>{% endif %}
</div>
{%- endunless %}
{%- if ui and ui.ok %}
<script type="text/javascript">
var SW = {{ ui | json }};
// ==== DRAW_BEGIN ====
// Section drawings: each [data-sw-part] element gets one SVG, drawn from the view data (SW) at the element's real size.
// Ink is currentColor; text--white marks paper, so dark mode flips both with the page. Shadows: light mode, 2-bit and up.
var SWDraw = (() => {
var API = { paint: null };
var GLYPH = { '0': 'abcdef', '1': 'bc', '2': 'abdeg', '3': 'abcdg', '4': 'bcfg', '5': 'acdfg', '6': 'acdefg', '7': 'abc', '8': 'abcdefg', '9': 'abcdfg', '-': 'g', ' ': '' };
var SHADOW = 'dark:hidden 1bit:hidden', SO = 3, K = 0;
function n1(v) { return String(Math.round(v * 10) / 10); }
function pts(p) { return p.map((q) => n1(q[0]) + ',' + n1(q[1])).join(' '); }
function poly(p, extra) { return '<polygon points="' + pts(p) + '"' + (extra || '') + '/>'; }
function rect(x, y, w, h, rx, extra) { return '<rect x="' + n1(x) + '" y="' + n1(y) + '" width="' + n1(Math.max(0, w)) + '" height="' + n1(Math.max(0, h)) + '"' + (rx ? ' rx="' + n1(rx) + '"' : '') + (extra || '') + '/>'; }
// Paint: the page sets SWDraw.paint (TRMNLPaint.bg at the part); a dither Fill becomes an SVG pattern. Without it
// (tests) the framework text class stands in. color= also feeds currentColor strokes inside the group.
var DEFS = '';
function g(cls, body) {
var keep = [], tok = null;
cls.split(' ').forEach((c) => { if (c.indexOf('text--') === 0) tok = c.slice(6); else if (c) keep.push(c); });
var f = tok && API.paint ? API.paint(tok) : null, at = '';
if (f && f.url && f.size) { var id = 'swp' + (K++); DEFS += '<pattern id="' + id + '" patternUnits="userSpaceOnUse" width="' + f.size + '" height="' + f.size + '">' + (f.color ? '<rect width="' + f.size + '" height="' + f.size + '" fill="' + f.color + '"/>' : '') + '<image href="' + f.url + '" width="' + f.size + '" height="' + f.size + '"/></pattern>'; at = ' fill="url(#' + id + ')"' + (f.color ? ' color="' + f.color + '"' : ''); }
else if (f && f.color) at = ' fill="' + f.color + '" color="' + f.color + '"';
else if (tok) keep.push('text--' + tok);
return '<g' + (keep.length ? ' class="' + keep.join(' ') + '"' : '') + at + '>' + body + '</g>';
}
function text(x, y, s, fs, anc, extra) { return '<text x="' + n1(x) + '" y="' + n1(y) + '" font-size="' + n1(fs) + '" font-weight="700" text-anchor="' + (anc || 'middle') + '"' + (extra || '') + '>' + s + '</text>'; }
function svg(W, H, body, vb) { var d0 = DEFS; DEFS = ''; return svg0(W, H, body, vb, d0); }
function svg0(W, H, body, vb, DEFS) { return '<svg xmlns="http://www.w3.org/2000/svg" width="' + n1(W) + '" height="' + n1(H) + '" viewBox="' + (vb || '0 0 ' + n1(W) + ' ' + n1(H)) + '" fill="currentColor" overflow="visible"' + (API.font ? ' font-family="' + API.font.replace(/"/g, "'") + '"' : '') + '>' + (DEFS ? '<defs>' + DEFS + '</defs>' : '') + body + '</svg>'; }
function hseg(x0, x1, y, t) { var h = t / 2; return [[x0, y], [x0 + h, y - h], [x1 - h, y - h], [x1, y], [x1 - h, y + h], [x0 + h, y + h]]; }
function vseg(x, y0, y1, t) { var h = t / 2; return [[x, y0], [x + h, y0 + h], [x + h, y1 - h], [x, y1], [x - h, y1 - h], [x - h, y0 + h]]; }
function shapes(x, w, h, t) {
var gp = Math.max(1, t * 0.16), xl = x + t / 2, xr = x + w - t / 2, yt = t / 2, ym = h / 2, yb = h - t / 2;
return { a: hseg(xl + gp, xr - gp, yt, t), g: hseg(xl + gp, xr - gp, ym, t), d: hseg(xl + gp, xr - gp, yb, t),
f: vseg(xl, yt + gp, ym - gp, t), b: vseg(xr, yt + gp, ym - gp, t), e: vseg(xl, ym + gp, yb - gp, t), c: vseg(xr, ym + gp, yb - gp, t) };
}
// Seven-segment digits, lit segments only (owner 2026-11-12: no ghost segments). The minus is narrow: no digit-wide gap.
function digits(str, H) {
var W = 56, HH = 100, T = 13, G = 14, x = 0, body = '';
for (var i = 0; i < str.length; i++) {
var ch = str.charAt(i);
if (ch === '.') { body += rect(x - G + 3, HH - T, T, T); x += 20 - G; continue; }
if (ch === '°') { body += '<circle cx="' + (x + 9) + '" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="5"/>'; x += 22 + G; continue; }
var w = ch === '-' ? 46 : W, on = GLYPH[ch] || '', sh = shapes(x, w, HH, T);
'abcdefg'.split('').forEach((s) => { if (on.indexOf(s) >= 0) body += poly(sh[s]); });
x += w + (ch === '-' ? G * 0.3 : G);
}
var vw = Math.max(1, x - G);
return svg(H * vw / HH, H, body, '0 0 ' + vw + ' ' + HH);
}
// Block meter (tuner SIGNAL): n cells, frac lit; lit cells drop a lighter shadow.
function meter(frac, W, H, n) {
n = n || 10;
var lit = frac === null || frac === undefined ? 0 : Math.round(Math.max(0, Math.min(1, frac)) * n), cw = (W - SO) / n, gp = cw * 0.12, ch = H - SO, on = '', sh = '', off = '';
for (var i = 0; i < n; i++) {
var x = i * cw + gp / 2, w = cw - gp;
