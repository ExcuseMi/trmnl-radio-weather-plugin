{%template main%}
{%-assign cf=trmnl.plugin_settings.custom_fields_values-%}{%-assign tsb='title title--small text--bold'%}{%assign fcy='flex flex--row flex--center-y'%}{%assign iia='image image--adaptive'-%}
{%-capture sw_stale_icon-%}<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="14" cy="14" r="10" stroke="#000" stroke-width="2.2"/><path d="M14 8V14L18 16.5" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{%-endcapture-%}
{%-capture sw_icon-%}<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M4 16A10 10 0 0 1 24 16" stroke="#000" stroke-width="2.2" stroke-linecap="round"/> <path d="M14 6V8.5M6.9 8.9L8.6 10.6M21.1 8.9L19.4 10.6" stroke="#000" stroke-width="1.6" stroke-linecap="round"/> <path d="M14 16L18.6 9.6" stroke="#000" stroke-width="2" stroke-linecap="round"/> <circle cx="14" cy="16" r="1.8" fill="#000"/> <rect x="3" y="21" width="4" height="4" rx="0.8" fill="#000"/><rect x="8.5" y="21" width="4" height="4" rx="0.8" fill="#000"/><rect x="14" y="21" width="4" height="4" rx="0.8" fill="#000"/> <rect x="19.5" y="21.5" width="4" height="3" rx="0.8" stroke="#000" stroke-width="1"/> </svg>{%-endcapture-%}

{%-capture p_open_g-%}<div class="relative h--full w--full"><div class="h--full w--full"><div class="relative h--full w--full p--1" data-sw-panel><div class="absolute inset--0" data-sw-part="face"></div>{%-endcapture-%}
{%-capture vr-%}<div class="border--v-60 1bit:hidden 2bit:hidden" data-sw-rule></div><div class="hidden 1bit:block 2bit:block border--v-black" data-sw-rule></div>{%-endcapture-%}
{%-capture p_close-%}</div></div></div>{%-endcapture-%}

{%-assign ml=ui.meters%}{%if ph%}{%assign i_w=trmnl.device.id|append:''%}{%if i_w != ''%}{%assign i_k='device_'|append:i_w%}{%for d in sensor_readings%}{%if d[0] == i_k and d[1].temperature.size > 0%}{%assign i_d=d[1]%}{%endif%}{%endfor%}{%endif%}
{%-assign i_q='temperature,humidity,carbon_dioxide'|split:','%}{%for q in i_q%}{%assign i_m=0%}{%assign i_v=nil%}{%assign i_l=i_d[q]%}{%for e in i_l%}{%assign kv=e|first%}{% assign s = kv[0] | date: '%s' | plus: 0 %}{%if s > i_m%}{%assign i_m=s%}{%assign i_v=kv[1]%}{%endif%}{%endfor%}{%assign i_a=trmnl.system.timestamp_utc|minus:i_m%}{%if i_a > 10800%}{%assign i_v=nil%}{%endif%}{%if forloop.index == 1%}{%assign i_t=i_v%}{%elsif forloop.index == 2%}{%assign i_h=i_v%}{%else%}{%assign i_c=i_v%}{%endif%}{%endfor%}
{%-if i_t != nil and ph.inn%}{%assign inn=ph.inn%}{%assign inn_hum=ph.inn.hum%}{%if i_h != nil%}{%assign ph_tw=ph.tw.k%}{%else%}{%assign inn_hum=''%}{%endif%}{%endif%}
{%-if i_c != nil and ph.mn%}{%assign ml=ph.mn%}{%elsif i_t != nil and i_h != nil and ph.hn%}{%assign ml=ph.hn%}{%endif%}{%endif%}
{%-if ui == nil or ui.ok != true-%}
<div class="layout layout--col layout--center" data-sw-error="{{model.reason|default:'NO SIGNAL'|escape}}">
<span class="title title--xlarge">{{i18n.ours.no_signal|default:'NO SIGNAL'}}</span>
<span class="description">{{model.reason|escape}}</span>
</div>
{%-elsif view >= 1 and view <= 4-%}

{%-assign stk=false%}{%assign hm=1%}{%assign hl=1%}{%assign wm=1%}{%assign wl=1%}{%assign n_md=9%}{%assign n_lg=9%}{%assign nd_md=4%}{%assign nd_lg=5%}{%assign num_cls=''%}{%assign bar_cls='col--span-8'%}{%assign name_cls='col--span-1'%}{%assign pad_cls='col--span-2'%}{%assign icon_cls='col--span-1'%}{%assign name_t=' lg:portrait:title--xlarge'%}{%assign icon_x=''%}{%assign rgw_l=18%}
{%-assign name_w='w--[6cqw] lg:w--[5cqw]'%}{%assign icon_w='w--[5cqw] lg:w--[5cqw]'%}{%assign num_w='w--[6cqw] lg:w--[5cqw]'%}
{%-if view == 1%}{%assign dgap='gap--small portrait:gap--xsmall lg:gap--small lg:portrait:gap--small'%}{%assign num_w='w--[6cqw] portrait:w--[5cqw] lg:w--[5cqw]'%}{%assign name_w='w--[9cqw] lg:w--[5cqw] lg:portrait:w--[12cqw]'%}{%assign icon_w='w--[5cqw] portrait:w--[8cqw] lg:w--[5cqw] lg:portrait:w--[10cqw]'%}{%assign hh_m=6%}{%assign rw_m=6%}{%assign num_cls=''%}{%assign bar_cls='col--span-8'%}{%assign name_cls='col--span-1 lg:portrait:col--span-2'%}{%assign icon_cls='col--span-1 lg:portrait:col--span-2'%}{%assign pad_cls='col--span-2 lg:portrait:col--span-4'%}{%assign name_t=' lg:portrait:title--xlarge'%}{%assign icon_x=' portrait:h--[7cqh] lg:portrait:h--[7cqh]'%}{%assign row_p=' portrait:h--[8cqh] lg:portrait:h--[6cqh]'%}{%assign con_h='h--[56cqh] lg:h--[38cqh] lg:portrait:h--[31cqh]'%}{%assign days_h='h--[37cqh] portrait:h--[38cqh] lg:h--[28cqh] lg:portrait:h--[33cqh]'%}
{%-elsif view == 2%}{%assign hm=1.7%}{%assign hl=2.2%}{%assign rgw_l=15%}{%assign mh_l=1.5%}{%assign con_h='h--full'%}
{%-elsif view == 3%}{%assign stk=true%}{%assign wm=2%}{%assign wl=2%}{%assign n_md=2%}{%assign n_lg=5%}{%assign name_cls='col--span-2'%}{%assign icon_cls='col--span-1 lg:col--span-2'%}{%assign pad_cls='col--span-3 lg:col--span-4'%}{%assign dgap='gap--xsmall lg:gap--small'%}{%assign num_t='title--small'%}{%assign nd_md=4%}{%assign nd_lg=7%}{%assign num_cls=' lg:hidden lg:portrait:flex'%}{%assign mr_m=6%}{%assign mb_m=4%}{%assign name_w='w--[26cqw] portrait:w--[12cqw] lg:w--[11cqw] lg:portrait:w--[15cqw]'%}{%assign icon_w='w--[7cqw] portrait:hidden lg:portrait:hidden'%}{%assign num_w='w--[9cqw] portrait:w--[7cqw] lg:portrait:w--[9cqw]'%}{%assign rw_m=6%}{%assign hh_m=6%}{%assign name_t=' portrait:title--small lg:portrait:title--base'%}{%assign rh_l=5%}{%assign icon_x=' lg:h--[6cqh]'%}{%assign bar_cls='col--span-7 lg:col--span-8'%}{%assign con_h='h--[60cqh] lg:h--[54cqh] lg:portrait:h--[44cqh]'%}{%assign days_h='h--[38cqh] lg:h--[44cqh] lg:portrait:h--[54cqh]'%}
{%-else%}{%assign stk=true%}{%assign wm=2%}{%assign wl=2%}{%assign hm=1.6%}{%assign hl=2.3%}{%assign n_md=1%}{%assign n_lg=2%}{%assign con_h='h--full'%}{%endif%}
{%-assign calm_btw=' 1bit:hidden 2bit:hidden dark:2bit:block'%}
{%-assign calm_q=false%}{%if view == 4%}{%assign calm_q=true%}{%endif%}
{%-if view == 3%}{%assign rw_m=8%}{%assign nd_md=3%}{%assign rh_l=6%}{%assign nd_lg=6%}{%assign row_p=' portrait:h--[11cqh] lg:portrait:h--[6cqh]'%}{%endif%}
{%-assign nd_mp=nd_md%}{%if view == 1%}{%assign nd_mp=4%}{%elsif view == 3%}{%assign nd_mp=5%}{%endif%}
{%-if view == 1%}{%assign rw_m=9%}{%assign rh_l=6%}{%assign nd_md=3%}{%assign nd_lg=4%}{%endif%}
{%-if mr_m == nil%}{%assign mr_m=9%}{%assign mb_m=7%}{%endif%}
{%-if view == 1%}{%for m in ml%}{%if m.tw or m.key == ph_tw%}{%assign mr_m=7.4%}{%endif%}{%endfor%}{%endif%}
{%-if mh_l == nil%}{%assign mh_l=hl%}{%endif%}

{%-assign q1=5|times:wm|round%}{%assign q2=23|times:wm|round%}{%assign q3w=26%}{%if ui.rain%}{%assign q3w=23%}{%endif%}{%assign q3=q3w|times:wl|round%}{%assign q4=30|times:wm|round|at_most:100%}{%assign ru_cls='flex--row lg:portrait:flex--col'%}{%assign su_cls='flex--row'%}{%assign q6b=20%}{%if stk%}{%assign q6b=15%}{%assign ru_cls='flex--col lg:flex--row'%}{%endif%}{%assign q6=q6b|times:wm|round%}{%assign rg_m='w--['|append:q6|append:'cqw]'%}{%assign rc_w='w--['|append:q2|append:'cqw] lg:w--['|append:q3|append:'cqw] lg:portrait:gap--xsmall'%}{%assign rule_w='w--['|append:q4|append:'cqw]'%}
{%-if stk%}{%assign rgw_l=15%}{%assign su_cls='flex--row'%}{%assign rc_w='w--[40cqw] lg:w--[37cqw] shrink-0'%}{%assign rule_w='w--full'%}{%assign tf=0.7%}{%assign mh_l=0.4%}{%if ui.rain%}{%assign su_cls='hidden lg:flex flex--row'%}{%assign sep_cls=' hidden lg:block'%}{%endif%}{%if view == 3%}{%assign su_cls='flex--row'%}{%assign sep_cls=''%}{%assign ru_cls='flex--row'%}{%assign rc_w='w--[44cqw] lg:w--[37cqw] lg:portrait:w--[42cqw] shrink-0'%}{%endif%}{%endif%}
{%-if view <= 2%}{%assign ru_cls='flex--row'%}{%endif%}
{%-if calm_q%}{%assign rc_w='w--[33cqw] lg:w--[39cqw] lg:portrait:w--full shrink-0'%}{%assign rg_m='w--[31cqw]'%}{%endif%}
{%-if hh_m == nil%}{%assign hh_m=6%}{%endif%}{%if rw_m == nil%}{%assign rw_m=6%}{%endif%}
{%-if rh_l == nil%}{%assign rh_l=4|times:hl|round|at_most:100%}{%endif%}
{%-if tf == nil%}{%assign tf=1%}{%endif%}{%assign tm=tf%}{%if view == 3%}{%assign tm=1%}{%endif%}
{%-if view == 4 and ui.rain == nil%}{%assign n_lg=3%}{%endif%}
{%-if stk%}{%assign ms=ml|sort:'rank'%}{%else%}{%assign ms=ml%}{%endif%}
{%-assign st_h=cf.hide_title_bar|append:''%}{%if ui.stale%}{%if view != 1 or st_h == 'true' or st_h == 'yes'%}{%assign st_on=true%}{%endif%}{%endif%}
<div class="layout layout--col layout--stretch-x gap--base relative" data-sw-debug="v2 view={{view}} meters={{ml|map:'key'|join:','}} rain={%if ui.rain%}cal{%else%}dry{%endif%} days={{ui.days|size}}">
{%-if st_on%}{%for sp in (1..2)%}{%if sp == 1%}{%assign sp_c='top--5 right--10'%}{%if view == 4%}{%assign sp_c='top--5 right--10 lg:hidden'%}{%endif%}{%elsif view == 4%}{%assign sp_c='top--5 left--10 hidden lg:block'%}{%else%}{%break%}{%endif%}<span class="absolute {{sp_c}} z--10 label label--small" data-sw-stale>{{ui.stale}}</span>{%endfor%}{%endif%}
{%-if view == 1%}
<div class="hidden lg:block h--[28cqh] lg:portrait:h--[22cqh]"><div class="flex flex--row flex--stretch-y gap--base h--full">
{%-for k in (1..2)%}
{%-if k == 2%}<div class="py--4 shrink-0 4bit:hidden dark:4bit:block{{calm_btw}}" data-sw-between><div class="border--v-60 h--full"></div></div>{%endif%}
{{p_open_g}}<div class="relative h--full w--full">
<div class="absolute inset--0" data-sw-part="{%if k == 1%}baro{%else%}tdial{%endif%}"></div>
<span class="absolute bottom--3 left--4 title title--base lg:portrait:title--small text--bold" data-sw-cap>{%if k == 1%}{{ui.baro.name}}{%else%}{{ui.tdial.name}}{%endif%}</span>
{%-capture dv_row%}

{%-if k == 1%}{%assign arw=ui.baro.arrow%}{%assign arw_i=0%}{%elsif inn%}{%assign arw=''%}{%else%}{%assign arw=ui.tdial.arrow%}{%assign arw_i=1%}{%endif%}{%if arw == 'up' or arw == 'down'%}<div class="shrink-0 self--center" data-sw-part="arrow" data-sw-i="{{arw_i}}" data-sw-arrow="{{arw}}"></div>{%endif%}
{%-if k == 1%}<span class="value value--small value--tnums">{{ui.baro.value}}</span><span class="{{tsb}}">{{ui.baro.unit}}</span>
{%-elsif inn%}<span class="value value--small value--tnums" data-sw-inval>{{inn.temp}}</span><span class="{{tsb}}">{{ui.tdial.unit}}</span>
{%-else%}<span class="value value--small value--tnums">{{ui.tdial.value}}</span><span class="{{tsb}}">{{ui.tdial.unit}}</span>{%endif-%}
{%-endcapture%}
<div class="absolute bottom--3 right--4 flex flex--row flex--bottom gap--small" data-sw-cap>{{dv_row}}</div>
{%-if k == 2 and inn%}<div class="absolute top--3 right--4 flex flex--row flex--bottom gap--small text--gray-30 dark:text--gray-30" data-sw-cap data-sw-dialin><div class="shrink-0 self--center h--[3cqh] w--[2cqw]" data-sw-part="loc" data-sw-sq data-sw-i="0" data-sw-loc="out"></div>{%if ui.tdial.arrow == 'up' or ui.tdial.arrow == 'down'%}<div class="shrink-0 self--center text--gray-30 dark:text--gray-30" data-sw-part="arrow" data-sw-i="1" data-sw-arrow="{{ui.tdial.arrow}}"></div>{%endif%}<span class="value value--small value--tnums text--gray-30 dark:text--gray-30">{{ui.tdial.value}}</span><span class="{{tsb}} text--gray-30 dark:text--gray-30">{{ui.tdial.unit}}</span></div>{%endif%}
</div>{{p_close}}
{%-endfor%}
</div></div>
<div class="hidden lg:block lg:4bit:hidden dark:lg:4bit:block{{calm_btw}} w--full px--4" data-sw-between><div class="border--h-60"></div></div>
{%-endif%}
{%if calm_q%}{%assign mr_m=6%}{%assign mb_m=4%}{%endif%}
{%capture c_meters%}
<div class="flex flex--col gap--small shrink-0 w--[{%if inn and view < 3%}{{25|times:wm|round}}{%else%}{{30|times:wm|round}}{%endif%}cqw] lg:w--[{%if inn and view == 2%}19{%else%}{{22|times:wm|round}}{%endif%}cqw] lg:portrait:w--full">
<div class="flex flex--row grow{%if view == 2%} lg:portrait:flex--stretch-y{%endif%} gap--small w--full">{%capture c_lab%}{%endcapture%}{%capture c_blk%}{%endcapture%}{%for m in ms%}{%if forloop.index > n_lg%}{%break%}{%endif%}{%assign passes=1%}{%if m.tw or m.key == ph_tw%}{%assign passes=2%}{%endif%}{%capture rc%}{%if view == 1 and m.key == 'baro'%}{%if forloop.index > n_md%} hidden{%else%} flex lg:hidden{%endif%}{%elsif forloop.index > n_md%} hidden lg:flex{%else%} flex{%endif%} flex--row flex--center-y{%endcapture%}{%capture rh%}h--[{{mr_m|times:hm|round|at_most:100}}cqh] lg:h--[{{5|times:hl|round}}cqh]{%if view == 1%} lg:portrait:h--[3cqh]{%endif%}{%endcapture%}{%for pass in (1..passes)%}{%assign h2=''%}{%assign pk='meter'%}{%if pass == 2%}{%assign h2=' data-sw-hum2'%}{%elsif m.tw or m.key == ph_tw%}{%assign pk='meterin'%}{%endif%}{%capture c_lab%}{{c_lab}}<div class="{{rc}} flex--right w--full gap--xsmall {{rh}}"{{h2}}>{%if m.tw or m.key == ph_tw%}<div class="shrink-0" data-sw-part="loc" data-sw-sq data-sw-for="{{m.key}}" data-sw-i="{{2|minus:pass}}" data-sw-loc="{%if pass == 1%}in{%else%}out{%endif%}"></div>{%endif%}<span class="title title--base lg:title--small text--bold" data-sw-mlabel>{{m.label}}</span></div>{%endcapture%}{%capture c_blk%}{{c_blk}}<div class="{{rc}} w--full {{rh}}"{{h2}}><div class="w--full h--[{{mb_m|times:hm|round|at_most:100}}cqh] lg:hidden" data-sw-part="{{pk}}" data-sw-n="5" data-sw-i="{{m.idx}}" data-sw-key="{{m.key}}"></div><div class="hidden lg:block w--full h--[{{4|times:hl|round}}cqh]{%if view == 1%} lg:portrait:h--[3cqh]{%endif%}" data-sw-part="{{pk}}" data-sw-n="10" data-sw-i="{{m.idx}}" data-sw-key="{{m.key}}"></div></div>{%endcapture%}{%endfor%}{%endfor%}{%capture mcol%}flex flex--col flex--between{%endcapture%}
<div class="{{mcol}} shrink-0">{{c_lab}}</div>
<div class="{{mcol}} grow">{{c_blk}}</div>
</div>
</div>{%endcapture%}{%capture c_temp%}
<div class="flex flex--col flex--center gap--medium grow w--min-0">
<div class="{{fcy}} flex--center-x w--full gap--medium h--[{{13|times:hm|times:tf|round}}cqh] lg:h--[{{8|times:hl|times:tf|round}}cqh] lg:portrait:h--[{%if view == 2%}9{%else%}5{%endif%}cqh]">{%if ui.icon%}<span class="block shrink-0 h--full aspect--1/1"><img class="{{iia}} h--full w--full" src="{{ui.icon}}" alt="" data-sw-ink="{{ui.iconInk}}" data-sw-icon></span>{%endif%}
<span class="title title--base lg:title--xlarge text--bold w--min-0" data-clamp="2" data-sw-cond>{{ui.cond}}</span>
</div>
<div class="{{rule_w}} h--[{{1|times:hm|round}}cqh]"></div>{%assign th_m=15%}{%assign th_l=13%}{%if inn%}{%assign th_m=22%}{%assign th_l=18%}{%endif%}{%assign tr_cls='flex--row flex--center-y flex--center-x w--full'%}{%assign tg_h='h--full'%}{%if view == 1%}{%assign th_m=22%}{%assign th_l=20%}{%if inn%}{%assign th_m=26%}{%assign th_l=22%}{%endif%}{%endif%}{%assign bw_m=9|times:wm|round%}{%assign bw_l=6|times:wl|round%}{%capture badge_w%}w--[{{bw_m}}cqw] lg:w--[{{bw_l}}cqw]{%if view == 1%} lg:portrait:w--[12cqw]{%endif%}{%endcapture%}{%assign ar_m=0.6%}{%assign ar_l=0.75%}{%if view == 2%}{%assign ar_m=0.3%}{%assign ar_l=0.375%}{%endif%}{%assign dh_m=th_m%}{%assign dh_l=th_l%}{%assign ch_p=7%}{%if inn%}{%assign dh_m=12%}{%assign dh_l=10%}{%assign ch_p=3.5%}{%endif%}{%assign ch_m=dh_m|times:hm|times:tm|times:0.85|round%}{%assign ch_l=dh_l|times:hl|times:tf|times:0.85|round%}{%assign cw_m=ch_m|times:ar_m|times:1.6|round%}{%assign cw_l=ch_l|times:ar_l|times:1.6|round%}{%assign cw_p=ch_p|times:2.1|round%}{%if view == 2%}{%assign cw_p=ch_p|times:1.1|round%}{%endif%}{%capture cbadge%}{%if ui.cue and ui.cue.size > 0%}<div class="shrink-0 h--[{{ch_m}}cqh] lg:h--[{{ch_l}}cqh] lg:portrait:h--[{{ch_p}}cqh] w--[{{cw_m}}cqw] lg:w--[{{cw_l}}cqw] lg:portrait:w--[{{cw_p}}cqw]" data-sw-part="cue" data-sw-cue="{{ui.cue|join:'+'}}"></div>{%endif%}{%endcapture%}
{%if view == 2%}{%assign th_m=th_m|times:1.15%}{%endif%}<div class="flex {{tr_cls}} {{tr_gap|default:'gap--small'}} lg:gap--medium h--[{{th_m|times:hm|times:tm|round|at_most:100}}cqh] lg:h--[{{th_l|times:hl|times:tf|round|at_most:100}}cqh] {%if view == 2%}lg:portrait:h--[17cqh]{%else%}{{tp_h|default:'lg:portrait:h--[8cqh]'}}{%endif%}">{%if inn%}{%assign tw_o='2,1'|split:','%}{%for tw_s in tw_o%}{%assign tw=tw_s|plus:0%}{%assign tw_k='in'%}{%if tw == 1%}{%assign tw_k='out'%}{%endif%}{%if forloop.index == 2%}<div class="border--v-60 h--full"></div>{%endif%}{%assign tw_dm=13%}{%assign tw_dl=12%}{%if view == 2%}{%assign tw_dm=15%}{%assign tw_dl=11%}{%endif%}
<div class="flex flex--col flex--center gap--xsmall h--full shrink-0" data-sw-twin="{{tw_k}}">

<div class="flex flex--row flex--top gap--xsmall"><div class="flex flex--col flex--center gap--xsmall"><div class="{{fcy}} gap--xsmall"><div class="shrink-0 h--[4cqh]" data-sw-part="loc" data-sw-sq data-sw-i="{{tw|minus:1}}" data-sw-loc="{{tw_k}}" data-sw-lz></div>{%if tw == 1%}{{cbadge|replace:'data-sw-part="cue"', 'data-sw-part="cue" data-sw-cb'}}{%endif%}</div><div class="h--[{{tw_dm|times:hm|times:tm|round|at_most:100}}cqh] lg:h--[{{tw_dl|times:hl|times:tf|round|at_most:100}}cqh] lg:portrait:h--[6cqh]" data-sw-part="{%if tw == 1%}temp{%else%}itemp{%endif%}"></div></div><div class="flex flex--col gap--xsmall"><div class="shrink-0 h--[4cqh]" data-sw-lsp></div><span class="value value--small" data-sw-unit="{%if tw == 2%}in{%endif%}">{{ui.unit}}</span></div></div>
{%-if tw == 2%}<span class="label label--small flex flex--row flex--center-y gap--xsmall">{{inn_hum}}</span>{%else%}<span class="label label--small">&nbsp;</span>{%endif%}
</div>{%endfor%}{%else%}
<div class="flex flex--row flex--top gap--xsmall shrink-0 {{tg_h}}"><div class="h--full" data-sw-part="temp"></div><span class="value value--small" data-sw-unit>{{ui.unit}}</span></div>{%if ui.cue and ui.cue.size > 0%}<div data-sw-div class="border--v-60 shrink-0 h--full"></div>{%endif%}
